{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm build:tokens && pnpm --filter @orbit/showcase dev",
    "storybook": "pnpm build:tokens && pnpm --filter @orbit/storybook dev",
    "build": "pnpm build:packages && pnpm --filter @orbit/showcase build && pnpm --filter @orbit/storybook build",
    "build:tokens": "pnpm --filter @orbit/tokens build",
    "build:packages": "pnpm --filter @orbit/tokens build && pnpm --filter @orbit/icons build && pnpm --filter @orbit/ui build",
    "test": "pnpm build:tokens && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:packages && pnpm --filter @orbit/showcase test:e2e",
    "test:visual": "pnpm build:packages && pnpm --filter @orbit/showcase test:visual",
    "typecheck": "pnpm build:tokens && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:package && pnpm test:e2e",
    "docs:tokens": "pnpm build:tokens && node scripts/generate-token-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
