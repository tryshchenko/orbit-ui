{
  "name": "@orbit/storybook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Orbit UI Storybook — the canonical design workspace.",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@orbit/icons": "workspace:*",
    "@orbit/tokens": "workspace:*",
    "@orbit/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "~9.1.0",
    "@storybook/addon-docs": "~9.1.0",
    "@storybook/react-vite": "~9.1.0",
    "storybook": "~9.1.0"
  }
}
